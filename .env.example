# =============================================================================
# OPTIONAL -- Copy to .env to customize behavior
#   cp .env.example .env
#
# All variables have sensible defaults and work without this file.
# =============================================================================

# Orchestrator model: haiku | sonnet | opus  (default: haiku)
# haiku  = fast, low token usage -- good for orchestrating
# sonnet = better reasoning -- use if orchestrator makes poor decisions
# ORCHESTRATOR_MODEL=haiku

# Sub-agent models (default: coding=sonnet, github=haiku)
# CODING_AGENT_MODEL=sonnet
# GITHUB_AGENT_MODEL=haiku

# Where generated projects are saved (default: ./generations)
# GENERATIONS_BASE_PATH=./generations

# Max iterations per run before pausing (default: 10)
# Lower this if you are hitting Pro plan token limits mid-session.
# MAX_ITERATIONS=10

# Enable Playwright browser UI testing (default: false)
# Requires: npx playwright install
# USE_PLAYWRIGHT=false
